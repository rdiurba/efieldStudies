#!/bin/bash
:<<'EOF'

Use this jobscript with justIN to run reconstruction on raw files:

justin simple-workflow --mql "files from <dataset> limit 10" --jobscript pdhdreco.jobscript --scope usertests --max-distance 100 --rss-mib 10000 --env INPUT_TAR_DIR_LOCAL="$INPUT_TAR_DIR_LOCAL" --output-pattern "*_reco_*.root:$FNALURL/$USERF" --output-pattern "*_reco_*.log:$FNALURL/$USERF" --lifetime 30

As in the data keepup configs in dune-prod-utils (production-scripts/data/
ProtoDUNE/NP02_keepup_*/reco_template.cfg: lar -c <fcl> -o %ifb_<tail>_...),
the outputs are named after the RAW INPUT FILE, so each reco file can be traced
back to its raw file. For raw file np04hd_raw_run031437_0003_....hdf5:
  np04hd_raw_run031437_0003_..._reco_<time>.root       art/ROOT reco file
  np04hd_raw_run031437_0003_..._reco_hist_<time>.root  TFileService file
  np04hd_raw_run031437_0003_..._reco_<time>.log        lar log
('*_reco_*.root' matches both the reco and the hist file, so both are kept)

AT THE MOMENT, NO METADATA IS GENERATED BY THIS JOBSCRIPT AND ONLY THE DEFAULT
JOB METADATA CREATED BY justIN WILL BE PUT INTO MetaCat FOR THESE FILES!

The reco fcl is set ONLY in this jobscript (FCL= below); it cannot be
overridden from the justin command. It is looked up anywhere inside the
tarball, then on FHICL_FILE_PATH (installed products); the job stops with an
error if it is in neither.

The following optional environment variables can be set when creating the
workflow/stage: NEVENTS, OUTPREFIX, DUNE_VERSION, DUNE_QUALIFIER,
SKIP_EXCEPTIONS

SKIP_EXCEPTIONS=1 : events whose processing throws are skipped instead of
failing the whole file. Done with a small wrapper fcl that #includes the reco
fcl unchanged and adds
  services.scheduler.SkipEvent: [ "StdException" ]

For example, add this line to the justin command to limit the processing to
10 events per file:
  --env NEVENTS=10

EOF


echo "Will setup"
#Setup general dune software
source /cvmfs/dune.opensciencegrid.org/products/dune/setup_dune.sh

#Setup recent lar software suite
export PRODUCTS="${INPUT_TAR_DIR_LOCAL}/protoduneana_calib/localProducts_larsoft_v10_26_00d03_e26_prof/:$PRODUCTS"
setup protoduneana \
   "${DUNE_VERSION:-v10_26_00d03}" \
   -q "${DUNE_QUALIFIER:-e26:prof}"
setup dunesw \
   "${DUNE_VERSION:-v10_26_00d03}" \
   -q "${DUNE_QUALIFIER:-e26:prof}"
export PRODUCTS="${INPUT_TAR_DIR_LOCAL}/protoduneana_calib/localProducts_larsoft_v10_26_00d03_e26_prof/:$PRODUCTS"

localProductsdir=`ls -c1d ${INPUT_TAR_DIR_LOCAL}/protoduneana_calib/localProducts*`
source ${localProductsdir}/setup-grid
mrbslp

# reco fcl: found anywhere in the tarball (top level, localProducts job/ or fcl/
# dirs, ...) by name; otherwise it must be on FHICL_FILE_PATH (installed product)
FCL="standard_reco_protodunehd_keepup_moreHits_100k_perTPC_noAPA1Fix.fcl"
fclname=$(basename "$FCL")
found=$(find -L "${INPUT_TAR_DIR_LOCAL}" -name "$fclname" -type f 2>/dev/null | head -1)
if [ -n "$found" ] ; then
  FCL="$found"
else
  onpath=""
  for d in ${FHICL_FILE_PATH//:/ } ; do
    if [ -f "$d/$fclname" ] ; then onpath="$d/$fclname" ; break ; fi
  done
  if [ -z "$onpath" ] ; then
    echo "ERROR: $fclname is neither in the tarball (${INPUT_TAR_DIR_LOCAL}) nor on FHICL_FILE_PATH"
    exit 1
  fi
  FCL="$onpath"
fi
echo "Using fcl: $FCL"

# optional: skip events that throw, via a wrapper fcl (reco fcl itself untouched)
if [ "${SKIP_EXCEPTIONS:-0}" = "1" ] ; then
  export FHICL_FILE_PATH="$(dirname "$FCL"):$FHICL_FILE_PATH"
  cat > skipexceptions_wrapper.fcl <<FCLEOF
#include "$fclname"
services.scheduler.SkipEvent: [ "StdException" ]
FCLEOF
  FCL="$PWD/skipexceptions_wrapper.fcl"
  echo "SKIP_EXCEPTIONS=1: running wrapper fcl:"; cat "$FCL"
fi

echo "Will use justin-get-file"
FILE=`$JUSTIN_PATH/justin-get-file | cut -f2 -d' '`
if [ -z "$FILE" ] || [[ "$FILE" != *.hdf5 ]] ; then
  echo "No input file from justin-get-file (got: '$FILE')"
  exit 0
fi
echo "Input: $FILE"

# output names from the raw input file name (data-keepup convention)
now=$(date -u +"%Y-%m-%dT_%H%M%SZ")
inbase=$(basename "$FILE")
inbase="${inbase%.*}"                                   # drop .hdf5
TAIL="${OUTPREFIX:-reco}"

# -o : art/ROOT reco output (overrides the RootOutput fileName in the fcl)
# -T : TFileService histogram file
# The raw input is HDF5, which HDF5 cannot read over root:// by itself: preload
# the XRootD POSIX library, in a subshell so it only affects lar (same as
# dune-justin/testing/dc4-vd-coldbox-bottom.jobscript).
(
export LD_PRELOAD=${XROOTD_LIB}/libXrdPosixPreload.so
echo "LD_PRELOAD=$LD_PRELOAD"
lar -c "$FCL" \
    -s "$FILE" \
    -o "${inbase}_${TAIL}_${now}.root" \
    -T "${inbase}_${TAIL}_hist_${now}.root" \
    -n "${NEVENTS:--1}" >"${inbase}_${TAIL}_${now}.log" 2>&1
)

larExit=$?
echo "lar exit code $larExit"

if [ $larExit -eq 0 ] ; then
  # Success !
  echo "$FILE" > justin-processed-pfns.txt
  jobscriptExit=0
else
  # Oh :(  remove the (empty / partial) ROOT outputs so they are not uploaded;
  # the log is kept
  rm -f "${inbase}_${TAIL}_${now}.root" "${inbase}_${TAIL}_hist_${now}.root"
  jobscriptExit=1
fi
echo "PRODUCTS=$PRODUCTS"
ups active | grep -i -E 'protoduneana|dunesw'
which lar
ls -l "${inbase}"_*
# error lines from anywhere in the lar log
echo "=== error lines in lar log ==="
grep -n -i -E 'unexpected input|\[error\]| error|exception|skipping event|SkipEvent' "${inbase}_${TAIL}_${now}.log" | grep -v NoisyFilterAlg | head -50
# Put last 100 lines of lar log into the HTCondor and Jobscript logs
tail -100 "${inbase}_${TAIL}_${now}.log"
exit $jobscriptExit

